# Vendored Potree renderer (own git clone; revision pinned in potree.version).
# Created by setup_potree_assets.bat: git clone + `npm install` builds build/.
# Note: the repo's own ignore rules for `build/` and `*.bin` above would also
# swallow potree/build/** and octree/hierarchy .bin chunks if it were tracked.
/potree/
/potree.version.local

# Session scratch (permission-recovery backups, repro scripts)
.dsh-acl-repair/
